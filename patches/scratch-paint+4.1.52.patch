@@ -0,0 +1,46 @@
+const START = 'scratch-paint/background-removal/START';
+const PROGRESS = 'scratch-paint/background-removal/PROGRESS';
+const END = 'scratch-paint/background-removal/END';
+
+const initialState = {
+    active: false,
+    phase: null,
+    progress: 0
+};
+
+const reducer = function (state, action) {
+    if (typeof state === 'undefined') state = initialState;
+    switch (action.type) {
+    case START:
+        return {active: true, phase: null, progress: 0};
+    case PROGRESS:
+        return {
+            active: true,
+            phase: action.phase,
+            progress: action.fraction
+        };
+    case END:
+        return initialState;
+    default:
+        return state;
+    }
+};
+
+const startBackgroundRemoval = function () {
+    return {type: START};
+};
+
+const setBackgroundRemovalProgress = function (phase, fraction) {
+    return {type: PROGRESS, phase: phase, fraction: fraction};
+};
+
+const endBackgroundRemoval = function () {
+    return {type: END};
+};
+
+export {
+    reducer as default,
+    startBackgroundRemoval,
+    setBackgroundRemovalProgress,
+    endBackgroundRemoval
+};
