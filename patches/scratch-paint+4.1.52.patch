@@ -0,0 +1,62 @@
+import classNames from 'classnames';
+import PropTypes from 'prop-types';
+import React from 'react';
+import {defineMessages, useIntl} from 'react-intl';
+
+import styles from './background-removal-overlay.css';
+
+const messages = defineMessages({
+    fetch: {
+        defaultMessage: 'Downloading model…',
+        description: 'Progress label shown while the background-removal model is downloading',
+        id: 'paint.modeTools.removingBackgroundFetch'
+    },
+    compute: {
+        defaultMessage: 'Removing background…',
+        description: 'Progress label shown while the background-removal model is running',
+        id: 'paint.modeTools.removingBackgroundCompute'
+    },
+    starting: {
+        defaultMessage: 'Preparing…',
+        description: 'Progress label shown before the first phase of background removal reports progress',
+        id: 'paint.modeTools.removingBackgroundStarting'
+    }
+});
+
+const BackgroundRemovalOverlayComponent = props => {
+    const intl = useIntl();
+    if (!props.active) return null;
+    const label = props.phase === 'fetch'
+        ? intl.formatMessage(messages.fetch)
+        : props.phase === 'compute'
+            ? intl.formatMessage(messages.compute)
+            : intl.formatMessage(messages.starting);
+    const fraction = Math.max(0, Math.min(1, props.progress || 0));
+    return (
+        <div
+            className={styles.overlay}
+            onMouseDown={e => e.stopPropagation()}
+            onClick={e => e.stopPropagation()}
+        >
+            <div className={styles.card}>
+                <div className={styles.spinner} />
+                <div className={styles.label}>{label}</div>
+                <progress
+                    className={classNames(styles.progress, {
+                        [styles.progressIndeterminate]: !props.phase
+                    })}
+                    max={1}
+                    value={props.phase ? fraction : undefined}
+                />
+            </div>
+        </div>
+    );
+};
+
+BackgroundRemovalOverlayComponent.propTypes = {
+    active: PropTypes.bool,
+    phase: PropTypes.oneOf(['fetch', 'compute']),
+    progress: PropTypes.number
+};
+
+export default BackgroundRemovalOverlayComponent;
