+@import "../../css/colors.css";
+@import "../../css/units.css";
+
+.overlay {
+    position: absolute;
+    inset: 0;
+    top: 0;
+    left: 0;
+    right: 0;
+    bottom: 0;
+    z-index: 1000;
+    background: hsla(215, 20%, 20%, 0.45);
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    pointer-events: auto;
+    cursor: progress;
+}
+
+.card {
+    background: white;
+    border-radius: 0.5rem;
+    padding: 1.25rem 1.5rem;
+    min-width: 18rem;
+    max-width: 22rem;
+    box-shadow: 0 0.25rem 0.75rem hsla(0, 0%, 0%, 0.25);
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    gap: 0.75rem;
+}
+
+.spinner {
+    width: 2rem;
+    height: 2rem;
+    border: 3px solid hsla(215, 20%, 50%, 0.25);
+    border-top-color: $looks-secondary;
+    border-radius: 50%;
+    animation: bg-removal-spin 0.9s linear infinite;
+}
+
+@keyframes bg-removal-spin {
+    to { transform: rotate(360deg); }
+}
+
+.label {
+    font-size: 0.875rem;
+    color: $text-primary;
+    font-weight: bold;
+    text-align: center;
+}
+
+.progress {
+    width: 100%;
+    height: 0.5rem;
+    appearance: none;
+    border: none;
+    border-radius: 0.25rem;
+    overflow: hidden;
+    background: hsla(215, 20%, 50%, 0.15);
+}
+
+.progress::-webkit-progress-bar {
+    background: hsla(215, 20%, 50%, 0.15);
+    border-radius: 0.25rem;
+}
+
+.progress::-webkit-progress-value {
+    background: $looks-secondary;
+    border-radius: 0.25rem;
+    transition: width 0.15s ease-out;
+}
+
+.progress::-moz-progress-bar {
+    background: $looks-secondary;
+    border-radius: 0.25rem;
+}
+
+.progressIndeterminate::-webkit-progress-value {
+    background: $looks-secondary;
+}
