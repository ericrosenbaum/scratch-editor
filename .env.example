# Anthropic API key for the vibe-server (used by `npm run vibe`)
ANTHROPIC_API_KEY=

# Optional: which Claude model to use for the agent loop
# VIBE_MODEL=claude-opus-4-7

# Optional: vibe-server port (default 3001). Webpack-dev-server proxies /api/vibe here.
# VIBE_PORT=3001

# Optional: bind address. Default 127.0.0.1 (localhost only).
# VIBE_HOST=127.0.0.1

# Optional: pino log level
# LOG_LEVEL=info
